{
  "name": "yva-time",
  "productName": "YVA Time",
  "version": "0.3.0",
  "description": "YVA Time \u2014 time tracker for YVA Staffing employees",
  "author": "YVA Staffing",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --publish never"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.100.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "electron-updater": "6.8.10",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
