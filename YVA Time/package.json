{
  "name": "yva-time",
  "productName": "YVA Time",
  "version": "0.1.0",
  "description": "YVA Time \u2014 time tracker for YVA Staffing employees",
  "author": "YVA Staffing",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@supabase/supabase-js": "2.100.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  },
  "build": {
    "appId": "agency.yvastaffing.time",
    "productName": "YVA Time",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "YVA-Time-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "protocols": [
      {
        "name": "YVA Time",
        "schemes": [
          "yvatime"
        ]
      }
    ]
  }
}
